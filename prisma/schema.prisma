// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
}

// Define custom output path for generated Prisma Client
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Table is "User"; adding @@map requires a rename migration.
model User {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  email          String    @unique
  password       String? // null for OAuth-only accounts
  name           String?
  role           Role      @default(CUSTOMER)
  emailVerified  DateTime?
  sessionVersion Int       @default(0)
  tokens         Token[]

  cart                 Cart?
  orders               Order[]
  inventoryAdjustments InventoryAdjustment[]
}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type, createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Orders are created by the Stripe webhook after payment, so there is no PENDING.
enum OrderStatus {
  PAID
  FULFILLED
  CANCELED
  REFUNDED
}

model Product {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  name        String
  description String
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status])
}

// Every product has at least one variant; price and stock live here.
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String?
  value      String?
  priceCents Int
  stock      Int // running total of InventoryAdjustment.delta; CHECK (stock >= 0) in SQL
  sku        String   @unique
  amazonAsin String?
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems            CartItem[]
  orderItems           OrderItem[]
  images               ProductImage[]
  inventoryAdjustments InventoryAdjustment[]

  // Also serves as the productId index. NULLs are distinct in Postgres, so
  // this does not stop two (null, null) variants on one product.
  @@unique([productId, name, value])
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String
  position  Int             @default(0)

  @@index([productId, position])
  @@index([variantId])
}

// Owned by a user OR a guest (CHECK exactly one, in SQL). A guest cart is
// keyed by the SHA-256 of a cookie token (see src/lib/tokens.ts) and is
// merged into the user's cart on sign-in. Checkout still requires an account.
model Cart {
  id             Int      @id @default(autoincrement())
  userId         Int?     @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items CartItem[]

  @@index([updatedAt]) // pruning abandoned guest carts
}

// No price stored: pricing is read fresh from the variant at checkout.
model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int // CHECK (quantity > 0) in SQL
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id     Int         @id @default(autoincrement())
  userId Int
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PAID)

  subtotalCents Int
  shippingCents Int
  taxCents      Int
  currency      String @default("usd")

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique

  email           String
  shippingAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([userId, createdAt])
}

// Snapshot of the listing at purchase time; later edits never rewrite it.
model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  productName    String
  variantLabel   String?
  sku            String
  unitPriceCents Int
  quantity       Int // CHECK (quantity > 0) in SQL

  @@index([orderId])
  @@index([variantId])
}

enum InventoryReason {
  INITIAL_STOCK
  RESTOCK
  MANUAL_RECOUNT
  CHANNEL_SALE_OTHER_PLATFORM
  ORDER_PLACED
  ORDER_CANCELED
}

// Append-only stock ledger. Restrict on variant so history can't be erased;
// retire variants with isActive = false instead of deleting them.
model InventoryAdjustment {
  id Int @id @default(autoincrement())

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  delta      Int
  stockAfter Int
  reason     InventoryReason
  note       String?

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([createdById])
}
