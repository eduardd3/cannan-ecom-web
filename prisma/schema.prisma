// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
}

// Define custom output path for generated Prisma Client
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Table is "User"; adding @@map requires a rename migration.
model User {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  email          String    @unique
  password       String? // null for OAuth-only accounts
  name           String?
  role           Role      @default(CUSTOMER)
  emailVerified  DateTime?
  sessionVersion Int       @default(0)
  tokens         Token[]

  cart                 Cart?
  orders               Order[]
  reviewedOrders       Order[]               @relation("OrderReviewResolvedBy")
  fulfilledOrders      Order[]               @relation("OrderFulfilledBy")
  trackingUpdates      Order[]               @relation("OrderTrackingUpdatedBy")
  inventoryAdjustments InventoryAdjustment[]
}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type, createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Orders are created by the Stripe webhook after payment, so there is no PENDING.
enum OrderStatus {
  PAID
  // Paid, but something needs a person: a line's stock ran short at webhook
  // time (sold on another channel mid-checkout), or Stripe's subtotal didn't
  // match the line prices. Lines that had stock were deducted; short lines
  // were not. An admin restocks and approves (→ PAID, writes ORDER_PLACED
  // rows only for lines with no ORDER_PLACED adjustment yet) or refunds
  // (→ REFUNDED).
  NEEDS_REVIEW
  FULFILLED
  // A dispute was lost before the order shipped: the money is gone and the
  // units this order took were put back (ORDER_CANCELED).
  CANCELED
  // Fully refunded. Units go back to stock only if the order hadn't shipped.
  REFUNDED
}

// Fixed so the admin page can build tracking links. OTHER has no link.
enum Carrier {
  USPS
  UPS
  FEDEX
  OTHER
}

// Where a collection's second filter (after product type) gets its values.
enum FacetSource {
  CATEGORY // the collection's Category rows (Devotion, Orisha)
  VARIANT_OPTION // values of the variant option named facetLabel (Color)
}

// Separate product lines; every product belongs to exactly one. The default
// collection is what general listings show (one default, partial unique in SQL).
// Rows are inserted by the migration, so production gets them too.
model Collection {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String
  isDefault   Boolean     @default(false)
  position    Int         @default(0) // order in the collection switcher
  // The second facet's name ("Devotion", "Orisha", "Color"); null = none.
  facetLabel  String?
  facetSource FacetSource @default(CATEGORY)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products   Product[]
  categories Category[]
}

// What an object is (Statues, Candles), shared by every collection. A table,
// not an enum, so new types don't need a migration. Rows are inserted by the
// migration, so production gets them too.
model ProductType {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String // plural, as shown in filters: "Framed prints"
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// The per-collection facet a product honors: a Devotion in Signature, an
// Orisha in Orishas. Each belongs to one collection, and a product's category
// must be in the product's collection (lib/products/save checks; a CHECK
// can't span tables). Collections whose facet comes from variant options
// (facetSource VARIANT_OPTION) have none.
model Category {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  name         String
  description  String?
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]

  @@index([collectionId])
}

model Product {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  description   String
  status        ProductStatus @default(DRAFT)
  collectionId  Int
  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  productTypeId Int
  productType   ProductType   @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  // Optional: Bibles and crucifixes honor no one in particular.
  categoryId    Int?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Variant option names, shared by every variant so they can't drift
  // ("Size" vs "Sizes"). Both null = one default variant. Option 1 shows
  // first in the picker; option2Name needs option1Name (CHECK in SQL).
  option1Name   String?
  option2Name   String?
  material      String? // "Resin, painted finish"; shown in Details
  isFinalSale   Boolean       @default(false) // seasonal pieces; see the Returns policy
  // First time the product went ACTIVE; never cleared. From then on its URL
  // may be indexed, so a slug change keeps the old one as a redirect.
  // An ACTIVE product always has it (CHECK in SQL).
  publishedAt   DateTime?
  // Shown first in the homepage's featured pieces (while visible); set from
  // the admin product page.
  featured      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  slugRedirects ProductSlugRedirect[]

  @@index([status])
  @@index([collectionId, status])
  @@index([productTypeId])
  @@index([categoryId])
}

// A published product's former slugs. /products/<old> redirects (308) to the
// product's current slug, so renames never break indexed links. Points at the
// product, not the next slug, so there are no redirect chains. A slug is
// either some product's current slug or some product's old one, never both;
// lib/products enforces that, since a unique index can't span two tables.
model ProductSlugRedirect {
  slug      String   @id
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Every product has at least one variant; price and stock live here.
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Values for the product's option1Name/option2Name: set exactly when the
  // product's name is (lib/products/variants and the seed check; a CHECK
  // can't span tables). option2Value needs option1Value (CHECK in SQL).
  option1Value String?
  option2Value String?
  // Inches, all three or none, each > 0 (CHECK in SQL). Decimal so 3.5 is
  // exact; the query layer converts before anything reaches the client.
  heightIn     Decimal? @db.Decimal(6, 2)
  widthIn      Decimal? @db.Decimal(6, 2)
  depthIn      Decimal? @db.Decimal(6, 2)
  priceCents   Int
  stock        Int // running total of InventoryAdjustment.delta; CHECK (stock >= 0) in SQL
  sku          String   @unique
  amazonAsin   String?
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems            CartItem[]
  orderItems           OrderItem[]
  images               ProductImage[]
  inventoryAdjustments InventoryAdjustment[]

  // Also serves as the productId index. NULLS NOT DISTINCT in SQL, so a
  // product has at most one (null, null) default variant.
  @@unique([productId, option1Value, option2Value])
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Storage key, never a full URL: "dev/products/<id>/<uuid>.jpg" in S3, or
  // "products/<slug>/1.jpg" for a dev seed image. getImageUrl in
  // src/lib/storage turns it into a URL, so moving hosts is an env change.
  key       String
  alt       String
  position  Int             @default(0)

  @@index([productId, position])
  @@index([variantId])
}

// Owned by a user OR a guest (CHECK exactly one, in SQL). A guest cart is
// keyed by the SHA-256 of a cookie token (see src/lib/tokens.ts) and is
// merged into the user's cart on sign-in. Checkout still requires an account.
model Cart {
  id             Int      @id @default(autoincrement())
  userId         Int?     @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items CartItem[]

  @@index([updatedAt]) // pruning abandoned guest carts
}

// No price stored: pricing is read fresh from the variant at checkout.
model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int // CHECK (quantity > 0) in SQL
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                 Int         @id @default(autoincrement())
  userId             Int
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             OrderStatus @default(PAID)
  // Why the order went to NEEDS_REVIEW. Required while in review (CHECK in
  // SQL) and kept after it's resolved, as history.
  reviewReason       String?
  // Who approved or refunded it, and when. Set only when leaving
  // NEEDS_REVIEW, and only on orders that had a reviewReason (CHECK in SQL).
  reviewResolvedAt   DateTime?
  reviewResolvedById Int?
  reviewResolvedBy   User?       @relation("OrderReviewResolvedBy", fields: [reviewResolvedById], references: [id], onDelete: SetNull)

  // Set together when the order ships (PAID → FULFILLED); a FULFILLED order
  // must have all three (CHECK in SQL). Kept if the order later changes
  // status, as history.
  carrier             Carrier?
  trackingNumber      String?
  fulfilledAt         DateTime?
  fulfilledById       Int?
  fulfilledBy         User?     @relation("OrderFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  // The last time carrier or tracking was corrected after shipping, and by
  // whom. Only on shipped orders (CHECK in SQL); fulfilledAt stays the ship date.
  trackingUpdatedAt   DateTime?
  trackingUpdatedById Int?
  trackingUpdatedBy   User?     @relation("OrderTrackingUpdatedBy", fields: [trackingUpdatedById], references: [id], onDelete: SetNull)

  subtotalCents Int
  shippingCents Int
  taxCents      Int
  currency      String @default("usd")

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique

  // Total refunded so far, mirrored from the Stripe charge (amount_refunded is
  // cumulative, so replays are harmless). A full refund also moves the order
  // to REFUNDED; a partial one only records the amount (CHECK >= 0 in SQL).
  refundedCents Int @default(0)

  // The charge's dispute, mirrored from Stripe's charge.dispute.* events. All
  // four are set together or not at all (CHECK in SQL). disputeStatus is
  // Stripe's own value (needs_response, under_review, won, lost, ...), kept
  // as text so a new Stripe status can't break the webhook.
  stripeDisputeId String?   @unique
  disputeStatus   String?
  disputeReason   String?
  disputedAt      DateTime?

  email           String
  shippingAddress Json?

  // When the order confirmation email went out. Sent once the order is PAID
  // (never while in NEEDS_REVIEW, CHECK in SQL); null means not sent yet.
  confirmationEmailSentAt DateTime?
  // When the shipped email (carrier and tracking) went out. Only on orders
  // that have shipped (CHECK in SQL); null means not sent yet. Tracking
  // corrections don't send another.
  shippedEmailSentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([userId, createdAt])
  @@index([status])
}

// Snapshot of the listing at purchase time; later edits never rewrite it.
model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  productName    String
  variantLabel   String?
  sku            String
  unitPriceCents Int
  quantity       Int // CHECK (quantity > 0) in SQL

  @@index([orderId])
  @@index([variantId])
}

enum InventoryReason {
  INITIAL_STOCK
  RESTOCK
  MANUAL_RECOUNT
  CHANNEL_SALE_OTHER_PLATFORM
  ORDER_PLACED
  ORDER_CANCELED
}

// Append-only stock ledger. Restrict on variant so history can't be erased;
// retire variants with isActive = false instead of deleting them.
model InventoryAdjustment {
  id Int @id @default(autoincrement())

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  delta      Int
  stockAfter Int
  reason     InventoryReason
  note       String?

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([createdById])
}
